---
permalink: /assets/js/catalog.js
eleventyExcludeFromCollections: true
---
{%- comment -%}
  Index local pentru căutarea predictivă + datele necesare coșului.
  Câmpuri scurtate deliberat (t/p/i/v) — 1203 produse, contează greutatea.
  În Shopify asta devine Predictive Search API; aici e JSON local, conform brief.
{%- endcomment -%}
window.__BASE__ = "{{ '/' | url }}";
window.__SEARCH__ = {
{%- for p in catalog.products -%}
"{{ p.handle }}":{"t":{{ p.title | json }},"p":{{ p.price }},"i":{% if p.image %}{{ p.image.src | json }}{% else %}null{% endif %},"v":{{ p.vendor | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
};
window.__CATALOG__ = window.__SEARCH__;
Object.keys(window.__CATALOG__).forEach(function(k){
  var s = window.__SEARCH__[k];
  window.__CATALOG__[k] = { title: s.t, price: s.p, image: s.i, vendor: s.v, available: true };
});
