---
permalink: /assets/js/catalog.js
eleventyExcludeFromCollections: true
---
{%- comment -%}
  Index local pentru căutarea predictivă + datele necesare coșului.
  Câmpuri scurtate deliberat (t/p/i/v) — 1203 produse, contează greutatea.
  În Shopify asta devine Predictive Search API; aici e JSON local, conform brief.
{%- endcomment -%}
window.__BASE__ = "{{ '/' | url }}";
window.__SEARCH__ = {
{%- for p in catalog.products -%}
"{{ p.handle }}":{"t":{{ p.title | json }},"p":{{ p.price }},"i":{% if p.image %}{{ p.image.src | json }}{% else %}null{% endif %},"v":{{ p.vendor | json }},"a":{% if p.available %}1{% else %}0{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
};
{%- comment -%}
  __CATALOG__ e un obiect NOU. Înainte era aceeași referință cu __SEARCH__, iar
  bucla îi rescria cheile scurte în chei lungi — deci buildIndex() din app.js,
  care citește p.t, primea undefined și căutarea predictivă nu găsea nimic.
{%- endcomment -%}
window.__CATALOG__ = {};
Object.keys(window.__SEARCH__).forEach(function(k){
  var s = window.__SEARCH__[k];
  window.__CATALOG__[k] = { title: s.t, price: s.p, image: s.i, vendor: s.v, available: s.a !== 0 };
});
