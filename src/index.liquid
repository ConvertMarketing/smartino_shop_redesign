---
layout: layouts/base.liquid
title: "SmartinoShop — Scutece Sleepy, igienă și curățenie"
description: "Prototip redesign. Scutece Sleepy pentru copii și adulți, produse de igienă, curățenie și cosmetice coreene originale."
extraCss: /assets/css/home.css
permalink: /index.html
---
{%- comment -%} Colecțiile reale, alese după ce chiar are produse {%- endcomment -%}
{%- assign c_best = catalog.collections | where: "handle", "best-seller" | first -%}
{%- assign c_red = catalog.collections | where: "handle", "reduceri" | first -%}
{%- assign c_kbeauty = catalog.collections | where: "handle", "cosmetice-coreene" | first -%}

{%- comment -%}
  Home: rail de categorii (stânga) + hero slider (dreapta), tipar de marketplace.
  Slide-urile folosesc doar afirmații confirmate — vezi docs/design-brief.md §2.
{%- endcomment -%}
{%- assign homeRail = true -%}
<section class="stage">
  {%- comment -%}
    Un singur h1 pe pagină. Titlurile din carusel sunt text de afișare (<p>):
    un h1 care se schimbă la fiecare rotire nu are sens semantic.
  {%- endcomment -%}
  <h1 class="visually-hidden">SmartinoShop — scutece Sleepy, produse de igienă, curățenie și cosmetice coreene</h1>
  <div class="container stage__inner">

    <div class="stage__rail">
      {% include "components/category-nav-rail.liquid" %}
    </div>

    <div class="stage__hero">
      <div class="hero" data-hero>
        <div class="hero__track" data-hero-track>

          {%- comment -%} Produs ales deliberat: ancora de brand e scutecul Sleepy. {%- endcomment -%}
          {%- assign hp = catalog.productsByHandle["scutece-chilotel-pentru-bebeluși-sleepy-natural-h20-marime-5-junior-11-18kg-24-bucati"] -%}
          {%- unless hp -%}
            {%- assign c_baby = catalog.collections | where: "handle", "scutece-copii" | first -%}
            {%- assign fb = c_baby.productHandles | first -%}
            {%- assign hp = catalog.productsByHandle[fb] -%}
          {%- endunless -%}
          <article class="slide slide--brand" data-slide>
            <div class="slide__text">
              <p class="slide__eyebrow">Importator unic în România</p>
              <p class="slide__title">Sleepy.<br>Scutece care<br>țin toată noaptea.</p>
              <p class="slide__lede">Bumbac organic, apă pură, testat dermatologic. De la nou-născut la 30&nbsp;kg.</p>
              <div class="slide__cta">
                <a class="btn btn--dark" href="{{ '/collections/scutece-copii/' | url }}">Vezi scutecele</a>
                <span class="slide__note">Livrare gratuită peste {{ shop.freeShipping }} lei</span>
              </div>
            </div>
            {%- if hp and hp.image -%}
              <div class="slide__media">
                <img src="{{ hp.image.src | cdn: 720 }}"
                     srcset="{{ hp.image.src | srcset: 400,560,720 }}"
                     sizes="(min-width: 1100px) 420px, 60vw"
                     alt="{{ hp.image.alt | escape }}" width="720" height="720"
                     fetchpriority="high" decoding="async">
              </div>
            {%- endif -%}
          </article>

          {%- assign kb = catalog.collections | where: "handle", "cosmetice-coreene" | first -%}
          {%- assign kh = kb.productHandles | first -%}
          {%- assign kp = catalog.productsByHandle[kh] -%}
          <article class="slide slide--kbeauty" data-slide hidden>
            <div class="slide__text">
              <p class="slide__eyebrow">Importator oficial</p>
              <p class="slide__title">Cosmetice<br>coreene, fără<br>intermediari.</p>
              <p class="slide__lede">Unleashia, Pyunkang Yul, Nard și Luvum — aduse direct, cu garanția autenticității.</p>
              <div class="slide__cta">
                <a class="btn btn--light" href="{{ '/collections/cosmetice-coreene/' | url }}">Descoperă colecția</a>
                <span class="slide__note">{{ kb.count }} produse în stoc</span>
              </div>
            </div>
            {%- if kp and kp.image -%}
              <div class="slide__media">
                <img src="{{ kp.image.src | cdn: 720 }}" srcset="{{ kp.image.src | srcset: 400,560,720 }}"
                     sizes="(min-width: 1100px) 420px, 60vw" alt="{{ kp.image.alt | escape }}"
                     width="720" height="720" loading="lazy" decoding="async">
              </div>
            {%- endif -%}
          </article>

          {%- assign top = catalog.saleFeatured | first -%}
          <article class="slide slide--sale" data-slide hidden>
            <div class="slide__text">
              <p class="slide__eyebrow">Reduceri active</p>
              <p class="slide__title">Până la<br><span class="slide__big">−{{ catalog.sale.maxPct }}%</span><br>la {{ catalog.sale.count }} de produse.</p>
              <p class="slide__lede">Prețuri reduse real, din catalogul curent. Fără cronometre inventate.</p>
              <div class="slide__cta">
                <a class="btn btn--dark" href="{{ '/collections/reduceri/' | url }}">Vezi reducerile</a>
              </div>
            </div>
            {%- if top and top.image -%}
              <div class="slide__media">
                <img src="{{ top.image.src | cdn: 720 }}" srcset="{{ top.image.src | srcset: 400,560,720 }}"
                     sizes="(min-width: 1100px) 420px, 60vw" alt="{{ top.image.alt | escape }}"
                     width="720" height="720" loading="lazy" decoding="async">
              </div>
            {%- endif -%}
          </article>

        </div>

        <button class="hero__arrow hero__arrow--prev" type="button" data-hero-prev aria-label="Slide-ul anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
        </button>
        <button class="hero__arrow hero__arrow--next" type="button" data-hero-next aria-label="Slide-ul următor">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        </button>

        <div class="hero__dots" role="tablist" aria-label="Alege slide-ul" data-hero-dots></div>
      </div>

      {%- comment -%}
        Două bannere sub hero. Acoperă ce nu acoperă slider-ul: al doilea public
        (incontinență, tratat sobru — vezi design-brief.md §6.6) și cea mai mare
        categorie din catalog (curățenie, 594 produse).
      {%- endcomment -%}
      <div class="minibanners">

        {%- assign c_inc = catalog.collections | where: "handle", "scutece-pentru-adulti" | first -%}
        {%- if c_inc -%}
          {%- assign ih = c_inc.productHandles | first -%}
          {%- assign ip = catalog.productsByHandle[ih] -%}
          <a class="mb mb--calm" href="{{ '/collections/scutece-pentru-adulti/' | url }}">
            <span class="mb__text">
              <span class="mb__eyebrow">Îngrijire adulți</span>
              <strong class="mb__title">Produse de incontinență</strong>
              <span class="mb__meta tnum">{{ c_inc.count }} produse · Sleepy, Dailee, Actual</span>
            </span>
            {%- if ip and ip.image -%}
              <span class="mb__media">
                <img src="{{ ip.image.src | cdn: 260 }}" srcset="{{ ip.image.src | srcset: 180,260,360 }}"
                     sizes="130px" alt="{{ ip.image.alt | escape }}"
                     width="260" height="260" loading="lazy" decoding="async">
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- assign c_cur = catalog.collections | where: "handle", "curatenie-intretinere" | first -%}
        {%- if c_cur -%}
          {%- assign ch = c_cur.productHandles | first -%}
          {%- assign cp = catalog.productsByHandle[ch] -%}
          <a class="mb mb--dark" href="{{ '/collections/curatenie-intretinere/' | url }}">
            <span class="mb__text">
              <span class="mb__eyebrow">Cea mai mare categorie</span>
              <strong class="mb__title">Curățenie &amp; menaj</strong>
              <span class="mb__meta tnum">{{ c_cur.count }} produse · Macromax, Kalyon, Scrub Daddy</span>
            </span>
            {%- if cp and cp.image -%}
              <span class="mb__media">
                <img src="{{ cp.image.src | cdn: 260 }}" srcset="{{ cp.image.src | srcset: 180,260,360 }}"
                     sizes="130px" alt="{{ cp.image.alt | escape }}"
                     width="260" height="260" loading="lazy" decoding="async">
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{%- comment -%}
  Bara de servicii. Fiecare rând e o afirmație confirmată (design-brief.md §6.7)
  și duce la pagina care o susține — Baymard cere acces direct la Livrare și Retur.
  Ella: `Custom Service Block`, nativ, cu SVG brut per iconiță.
{%- endcomment -%}
<section class="usp" aria-label="Livrare, retur și plată">
  <div class="container usp__inner">
    {%- comment -%}
      Separator „~", nu virgulă: textele conțin virgule („curier 24,90 lei",
      „3D Secure, PayU"), iar split-ul pe virgulă rupea itemii în bucăți.
    {%- endcomment -%}
    {%- comment -%}
      Liquid nu interpolează în literale de șir, deci pragurile intră prin capture,
      nu direct în textul de mai jos.
    {%- endcomment -%}
    {%- capture usps_raw -%}
truck|Livrare gratuită|peste {{ shop.freeShipping }} lei|/pages/livrare/~clock|Livrare în 1–3 zile|{{ shop.shippingFee | lei }} · easybox {{ shop.easyboxFee }} lei|/pages/livrare/~return|Retur în {{ shop.returnDays }} zile|conform OUG 34/2014|/pages/politica-de-retur/~card|Ramburs sau card|3D Secure, PayU și MobilPay|/pages/metode-de-plata/
    {%- endcapture -%}
    {%- assign usps = usps_raw | strip | split: "~" -%}
    {%- for u in usps -%}
      {%- assign f = u | split: "|" -%}
      <a class="usp__item" href="{{ f[3] | url }}">
        <span class="usp__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            {%- assign icon = f[0] -%}{% include "components/icons.liquid" %}
          </svg>
        </span>
        <span class="usp__text">
          <strong>{{ f[1] }}</strong>
          <span class="usp__sub">{{ f[2] }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{%- comment -%} Categorii — punctele de intrare care separă publicurile {%- endcomment -%}
<section class="section container">
  <div class="section__head"><h2>Cumpără pe categorii</h2></div>
  <div class="cats">
    {%- assign catHandles = "scutece-copii,produse-incontinenta,servetele-umede,curatenie-intretinere,produse-din-hartie,cosmetice-coreene" | split: "," -%}
    {%- for h in catHandles -%}
      {%- assign col = catalog.collections | where: "handle", h | first -%}
      {%- if col -%}
        {%- assign firstHandle = col.productHandles | first -%}
        {%- assign fp = catalog.productsByHandle[firstHandle] -%}
        <a class="cat" href="{{ '/collections/' | append: col.handle | append: '/' | url }}">
          <span class="cat__media">
            {%- if fp and fp.image -%}
              <img src="{{ fp.image.src | cdn: 240 }}" srcset="{{ fp.image.src | srcset: 160,240,320 }}"
                   sizes="120px" alt="" width="240" height="240" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
          <span class="cat__name">{{ col.title }}</span>
          <span class="cat__count tnum">{{ col.count }} produse</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} Bestsellers {%- endcomment -%}
{%- if c_best -%}
<section class="section container">
  <div class="section__head">
    <h2>Cele mai vândute</h2>
    <a class="section__link" href="{{ '/collections/best-seller/' | url }}">Vezi toate →</a>
  </div>
  <div class="grid-products">
    {%- assign bestList = c_best.productHandles | slice: 0, 8 -%}
    {%- for h in bestList -%}
      {%- assign product = catalog.productsByHandle[h] -%}
      {%- if product -%}{% include "components/product-card.liquid" %}{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- comment -%} Reduceri reale — doar produse cu compare_at_price {%- endcomment -%}
<section class="section section--sale">
  <div class="container">
    <div class="section__head">
      <h2>Reduceri</h2>
      <a class="section__link" href="{{ '/collections/reduceri/' | url }}">Vezi toate →</a>
    </div>
    <div class="grid-products">
      {%- comment -%}
        Selecție diversificată pe vendor (vezi catalog.js): „primele 8" dădea
        opt pachete de șervețele aproape identice.
      {%- endcomment -%}
      {%- for product in catalog.saleFeatured -%}
        {% include "components/product-card.liquid" %}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Cosmetice coreene — diferențiatorul de importator oficial {%- endcomment -%}
{%- if c_kbeauty -%}
<section class="section container">
  <div class="kbeauty">
    <div class="kbeauty__text">
      <p class="kbeauty__eyebrow">Importator oficial</p>
      <h2>Cosmetice coreene, originale</h2>
      <p>
        Unleashia, Pyunkang Yul, Nard și Luvum — aduse direct, cu garanția
        autenticității. {{ c_kbeauty.count }} produse în stoc.
      </p>
      <a class="btn btn--primary" href="{{ '/collections/cosmetice-coreene/' | url }}">Descoperă colecția</a>
    </div>
    <div class="kbeauty__grid">
      {%- assign kList = c_kbeauty.productHandles | slice: 0, 4 -%}
      {%- for h in kList -%}
        {%- assign kp = catalog.productsByHandle[h] -%}
        {%- if kp and kp.image -%}
          <a class="kbeauty__tile" href="{{ '/products/' | append: kp.handle | append: '/' | url }}">
            <img src="{{ kp.image.src | cdn: 300 }}" srcset="{{ kp.image.src | srcset: 200,300,400 }}"
                 sizes="(min-width:900px) 180px, 40vw" alt="{{ kp.image.alt | escape }}"
                 width="300" height="300" loading="lazy" decoding="async">
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%}
  Recenzii — DATE SIMULATE (src/_data/reviews.js). La implementare secțiunea
  primește feed-ul Judge.me și eticheta „date demonstrative" dispare odată cu
  flag-ul DEMO. Vezi docs/ella-mapping.md §3.5/C5.
{%- endcomment -%}
<section class="section container" aria-labelledby="rev-title">
  <div class="section__head section__head--wrap">
    <h2 id="rev-title">Ce spun clienții</h2>
    {%- if reviews.DEMO -%}
      <span class="demo-tag">date demonstrative</span>
    {%- endif -%}
  </div>

  <div class="rvs">
    <div class="rvs__score">
      <p class="rvs__num">{{ reviews.avg | replace: ".", "," }}</p>
      <span class="stars stars--lg" style="--n:{{ reviews.avg }}" aria-hidden="true"></span>
      <p class="rvs__meta">
        {{ reviews.total | nr }} recenzii<br>
        pentru {{ reviews.rated }} produse
      </p>
    </div>

    <ul class="rvs__bars">
      {%- for d in reviews.dist -%}
        <li>
          <span class="rvs__lbl">{{ d.stars }}<span aria-hidden="true">★</span></span>
          <span class="rvs__track"><span class="rvs__fill" style="width:{{ d.pct }}%"></span></span>
          <span class="rvs__cnt">{{ d.count | nr }}</span>
        </li>
      {%- endfor -%}
    </ul>

    <p class="rvs__note">
      Fiecare recenzie vine de la o comandă livrată. Nu ștergem notele mici —
      dacă un produs nu e bun, se vede aici înainte să îl cumperi.
    </p>
  </div>

  <ul class="rvs__list">
    {%- for r in reviews.featured -%}
      <li class="rvc">
        <div class="rvc__top">
          <span class="stars" style="--n:{{ r.stars }}" aria-hidden="true"></span>
          <span class="visually-hidden">{{ r.stars }} din 5 stele</span>
          <span class="rvc__ok">achiziție confirmată</span>
        </div>
        <p class="rvc__text">{{ r.text }}</p>
        <p class="rvc__by">{{ r.autor }} · <time>{{ r.data }}</time></p>
        <a class="rvc__prod" href="{{ '/products/' | append: r.handle | append: '/' | url }}">
          <img src="{{ r.image.src | cdn: 120 }}" srcset="{{ r.image.src | srcset: 80,120,160 }}"
               sizes="56px" alt="" width="56" height="56" loading="lazy" decoding="async">
          <span>{{ r.product }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{%- comment -%} Magazine fizice — activ de încredere real {%- endcomment -%}
<section class="section container">
  <div class="stores">
    <div class="stores__item">
      <h3>Smartino Supermarket</h3>
      <p>Snagov Plaza, DN1 · jud. Ilfov</p>
      <p class="stores__hours">Luni–Vineri 07:00–22:00 · Sâmbătă–Duminică 08:00–21:00</p>
      <p class="stores__tel"><a href="tel:+40755210178">0755 210 178</a></p>
    </div>
    <div class="stores__item">
      <h3>Smartino Home &amp; Deco</h3>
      <p>Snagov Plaza, vizavi de supermarket</p>
      <p class="stores__hours">Peste 1.200 mp de mobilier, decor și grădină</p>
    </div>
  </div>
</section>

<section class="newsletter">
  <div class="container newsletter__inner">
    <div>
      <h2>Ofertele, direct pe email</h2>
      <p>Reduceri și produse noi. Fără spam.</p>
    </div>
    <form class="newsletter__form" onsubmit="return false;">
      <label class="visually-hidden" for="nl">Adresa ta de email</label>
      <input id="nl" type="email" placeholder="adresa@email.ro" required>
      <button class="btn btn--primary" type="submit">Abonează-mă</button>
    </form>
  </div>
</section>
