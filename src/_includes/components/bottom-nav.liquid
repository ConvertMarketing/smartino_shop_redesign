{%- comment -%}
  Bară de navigație fixă, doar pe mobil. Tiparul standard de comerț mobil:
  patru destinații, degetul mare ajunge la toate.
  Fără „Cont" — prototipul nu include cont client (CLAUDE.md).
  Ella: „Sticky Toolbar Mobile" e nativ (ella-mapping.md G4).
{%- endcomment -%}
<nav class="botnav" aria-label="Navigație principală">
  <a class="botnav__item{% if page.url == '/' %} is-active{% endif %}" href="{{ '/' | url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m4 10 8-6 8 6v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M9.5 21v-6h5v6"/>
    </svg>
    <span>Acasă</span>
  </a>

  <button class="botnav__item" type="button" data-open-nav aria-expanded="false" aria-controls="cat-panel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/>
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/>
    </svg>
    <span>Categorii</span>
  </button>

  <button class="botnav__item" type="button" data-focus-search>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    </svg>
    <span>Caută</span>
  </button>

  <button class="botnav__item" type="button" data-open-cart>
    <span class="botnav__icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="botnav__count" data-cart-count hidden>0</span>
    </span>
    <span>Coș</span>
  </button>
</nav>
