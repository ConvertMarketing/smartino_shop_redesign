---
pagination:
  data: pdp
  size: 1
  alias: pp
permalink: "/products/{{ pp.handle }}/index.html"
layout: layouts/base.liquid
extraCss: /assets/css/pdp.css
hideBottomNav: true
eleventyComputed:
  title: "{{ pp.product.title }}"
  description: "{{ pp.product.title }} — {{ pp.product.vendor }}. Prototip Smartino."
---
{%- assign p = pp.product -%}
{%- assign bani_total = p.price | times: 100 | round -%}
{%- assign lei_int = bani_total | divided_by: 100 | floor -%}
{%- assign bani = bani_total | modulo: 100 -%}

<div class="pdp" data-pdp data-handle="{{ p.handle }}">
<div class="pdp__hero">
  <div class="container">

  <nav class="crumbs" aria-label="Firul de navigare">
    <ol>
      <li><a href="{{ '/' | url }}">Acasă</a></li>
      {%- if pp.crumb -%}
        <li><a href="{{ '/collections/' | append: pp.crumb.handle | append: '/' | url }}">{{ pp.crumb.title }}</a></li>
      {%- endif -%}
      <li><span aria-current="page">{{ p.title | truncate: 48 }}</span></li>
    </ol>
  </nav>

  <div class="pdp__top">

    {%- comment -%}
      Galeria. 913 din 1.203 produse au o singură imagine, deci cazul normal e
      unul singur: bara de miniaturi apare doar când chiar există ce alege.
    {%- endcomment -%}
    <div class="gal{% if p.images.size > 1 %} gal--multi{% endif %}" data-gal>
      <div class="gal__stage">
        {%- for img in p.images limit: 8 -%}
          <figure class="gal__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
            <img src="{{ img.src | cdn: 900 }}"
                 srcset="{{ img.src | srcset: 400,600,900,1200 }}"
                 sizes="(min-width: 1000px) 560px, 100vw"
                 alt="{{ img.alt | escape }}"
                 width="900" height="900"
                 {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                 decoding="async">
          </figure>
        {%- endfor -%}
        {%- unless p.available -%}<span class="gal__out">Stoc epuizat</span>{%- endunless -%}
        {%- if p.discountPct -%}<span class="gal__deal">−{{ p.discountPct }}%</span>{%- endif -%}
        {%- if p.images.size > 1 -%}
          <p class="gal__n" data-gal-n><span>1</span> / {{ p.images.size | at_most: 8 }}</p>
        {%- endif -%}
      </div>
      {%- if p.images.size > 1 -%}
        <div class="gal__thumbs" role="tablist" aria-label="Imaginile produsului">
          {%- for img in p.images limit: 8 -%}
            <button class="gal__thumb{% if forloop.first %} is-active{% endif %}" type="button"
                    role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-go="{{ forloop.index0 }}" aria-label="Imaginea {{ forloop.index }}">
              <img src="{{ img.src | cdn: 160 }}" alt="" width="80" height="80" loading="lazy" decoding="async">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Blocul de cumpărare. Ordinea e ordinea deciziei. {%- endcomment -%}
    <div class="buy">
      {%- comment -%} Linia de identificare, ca pe smartinohome.ro. {%- endcomment -%}
      <ul class="buy__meta">
        {%- if p.vendor != blank -%}<li><span>Furnizor:</span> <b>{{ p.vendor }}</b></li>{%- endif -%}
        {%- if p.sku != blank -%}<li><span>Cod:</span> <b>{{ p.sku }}</b></li>{%- endif -%}
      </ul>
      <h1 class="buy__title">{{ p.title }}</h1>

      {%- if pp.specs.size > 0 -%}
        <ul class="buy__specs">
          {%- for s in pp.specs limit: 3 -%}
            <li><span>{{ s[0] }}</span><b>{{ s[1] }}</b></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign rv = reviews.byHandle[p.handle] -%}
      {%- if rv and rv.count > 0 -%}
        <a class="buy__rate" href="#recenzii" data-go-tab="rev">
          <span class="stars" style="--n:{{ rv.avg }}" aria-hidden="true"></span>
          <b>{{ rv.avg | replace: ".", "," }}</b>
          <span>din {{ rv.count }} recenzii</span>
        </a>
      {%- endif -%}

      <div class="buy__price">
        <span class="price{% if p.compareAt %} price--sale{% endif %}">
          <span aria-hidden="true">{{ lei_int }}<sup>{% if bani < 10 %}0{% endif %}{{ bani }}</sup><span class="price__cur">lei</span></span>
          <span class="visually-hidden">{{ p.price | lei }}</span>
        </span>
        {%- if p.compareAt -%}
          <s class="price__was"><span class="visually-hidden">preț anterior </span>{{ p.compareAt | lei }}</s>
          <span class="buy__save">economisești {{ pp.saves | lei }}</span>
        {%- endif -%}
      </div>

      <p class="buy__stock{% unless p.available %} buy__stock--out{% endunless %}">
        {%- if p.available -%}
          <span class="dot" aria-hidden="true"></span>În stoc — expediere în 24h
        {%- else -%}
          <span class="dot" aria-hidden="true"></span>Stoc epuizat
        {%- endif -%}
      </p>

      <div class="buy__act" data-add-wrap>
        <div class="qty" role="group" aria-label="Cantitate">
          <button type="button" data-q="-1" aria-label="Scade cantitatea">−</button>
          <input type="text" inputmode="numeric" value="1" data-qty aria-label="Cantitate">
          <button type="button" data-q="1" aria-label="Crește cantitatea">+</button>
        </div>
        <button class="btn btn--primary buy__cta" type="button" data-add="{{ p.handle }}"
                {% unless p.available %}disabled{% endunless %}>
          {%- if p.available -%}Adaugă în coș{%- else -%}Indisponibil{%- endif -%}
        </button>
      </div>

      <div class="buy__aux">
        <button class="auxbtn" type="button" aria-pressed="false" data-fav>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/></svg>
          Adaugă la favorite
        </button>
        <button class="auxbtn" type="button" data-share>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5 15.4 17.5M15.4 6.5 8.6 10.5"/></svg>
          Trimite
        </button>
      </div>

      {%- comment -%}
        Blocul de încredere, cu textele reale de pe smartinohome.ro — magazinul
        soră al grupului. Nu inventate: e limbajul pe care clientul îl folosește
        deja despre el însuși.
      {%- endcomment -%}
      <ul class="trust">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg>
          <b>Produse originale</b><span>Branduri verificate</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
          <b>Retur {{ shop.returnDays }} zile</b><span>Fără întrebări</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <b>Plată securizată</b><span>SSL & 3D Secure</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <b>Suport rapid</b><span>Răspuns în 2h, L–V</span>
        </li>
      </ul>

      {%- comment -%}
        Cross-sell. NU „cele mai frecvent cumpărate împreună": exportul n-are
        date de comenzi, iar afirmația n-ar avea nimic în spate. Sunt produse
        complementare — alt tip, din cea mai specifică colecție comună, mai
        ieftine decât produsul principal, ca să funcționeze ca adaos.
      {%- endcomment -%}
      {%- if pp.crossSell.size > 0 -%}
        <section class="fbt" data-fbt data-base="{{ p.price }}">
          <h2 class="fbt__h">Completează comanda</h2>
          <p class="fbt__s">Produse care se potrivesc cu ce ai ales</p>

          <ul class="fbt__list">
            <li class="fbt__row fbt__row--base">
              <span class="fbt__pic">
                <img src="{{ p.image.src | cdn: 120 }}" alt="" width="52" height="52" loading="lazy" decoding="async">
              </span>
              <span class="fbt__t">{{ p.title | truncate: 58 }}<span class="fbt__this">produsul ales</span></span>
              <span class="fbt__p tnum">{{ p.price | lei }}</span>
            </li>
            {%- for q in pp.crossSell -%}
              <li class="fbt__row">
                <label>
                  <input type="checkbox" checked data-x="{{ q.price }}" data-handle="{{ q.handle }}">
                  <span class="fbt__box" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12 6 6L20 6"/></svg>
                  </span>
                  <span class="fbt__pic">
                    <img src="{{ q.image.src | cdn: 120 }}" alt="" width="52" height="52" loading="lazy" decoding="async">
                  </span>
                  <span class="fbt__t">
                    <a href="{{ '/products/' | append: q.handle | append: '/' | url }}">{{ q.title | truncate: 58 }}</a>
                  </span>
                  <span class="fbt__p tnum">{{ q.price | lei }}</span>
                </label>
              </li>
            {%- endfor -%}
          </ul>

          <div class="fbt__foot">
            <p class="fbt__tot">Total <b data-fbt-total>{{ pp.crossTotal | lei }}</b>
              <span data-fbt-n>{{ pp.crossSell.size | plus: 1 }} produse</span></p>
            <button class="btn btn--primary" type="button" data-fbt-add>Adaugă tot în coș</button>
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

  </div>
</div>

<div class="container pdp__rest">
  {%- comment -%}
    Taburi, nu acordeoane — tiparul de pe smartinohome.ro, unde conținutul de
    livrare e la fel de important ca descrierea și merită să fie la un click,
    nu ascuns sub descriere.
  {%- endcomment -%}
  <div class="tabs" data-tabs>
    <div class="tabs__nav" role="tablist" aria-label="Detalii produs">
      {%- if pp.body != blank -%}
        <button class="tabs__t is-on" type="button" role="tab" aria-selected="true" data-tab="desc">Descriere produs</button>
      {%- endif -%}
      {%- if pp.specs.size > 0 -%}
        <button class="tabs__t{% if pp.body == blank %} is-on{% endif %}" type="button" role="tab"
                aria-selected="{% if pp.body == blank %}true{% else %}false{% endif %}" data-tab="spec">Specificații</button>
      {%- endif -%}
      <button class="tabs__t" type="button" role="tab" aria-selected="false" data-tab="ship">Livrare &amp; retur</button>
      <button class="tabs__t" type="button" role="tab" aria-selected="false" data-tab="rev">Recenzii</button>
    </div>

    <div class="tabs__panes">
      {%- if pp.body != blank -%}
        <section class="tabs__p is-on" data-pane="desc" role="tabpanel"><div class="rte">{{ pp.body }}</div></section>
      {%- endif -%}

      {%- if pp.specs.size > 0 -%}
        <section class="tabs__p{% if pp.body == blank %} is-on{% endif %}" data-pane="spec" role="tabpanel">
          <dl class="spectable">
            {%- for s in pp.specs -%}<div><dt>{{ s[0] }}</dt><dd>{{ s[1] }}</dd></div>{%- endfor -%}
          </dl>
          <p class="spectable__note">Valorile sunt extrase din titlul produsului.
          La implementare devin metacâmpuri — vezi docs/ella-mapping.md §3.4.</p>
        </section>
      {%- endif -%}

      <section class="tabs__p" data-pane="ship" role="tabpanel">
        <div class="rte">
          <h3>Livrare</h3>
          <p>Livrăm pe întreg teritoriul României prin curier rapid, în
          <strong>1–3 zile lucrătoare</strong>. Comenzile sunt procesate în 1–2 zile
          lucrătoare de la confirmare.</p>
          <dl class="spectable">
            <div><dt>Comandă sub {{ shop.freeShipping }} lei</dt><dd>{{ shop.shippingFee | lei }}</dd></div>
            <div><dt>Comandă peste {{ shop.freeShipping }} lei</dt><dd>gratuit</dd></div>
            <div><dt>Livrare la easybox</dt><dd>{{ shop.easyboxFee | lei }}</dd></div>
          </dl>
          <h3>Retur</h3>
          <p>Ai <strong>{{ shop.returnDays }} zile</strong> să returnezi produsul, conform
          OUG 34/2014, fără să motivezi decizia. Transportul de retur este suportat de client.</p>
        </div>
      </section>

      <section class="tabs__p" data-pane="rev" role="tabpanel" id="recenzii">
        {%- if rv and rv.count > 0 -%}
          <div class="revs">
            <div class="revs__sum">
              <p class="revs__avg">{{ rv.avg | replace: ".", "," }}<span>din 5</span></p>
              <span class="stars stars--lg" style="--n:{{ rv.avg }}" aria-hidden="true"></span>
              <p class="revs__n">{{ rv.count }} recenzii</p>
              {%- if reviews.DEMO -%}<p class="demo-tag">date demonstrative</p>{%- endif -%}
            </div>
            <ol class="revs__list">
              {%- for r in rv.list -%}
                <li class="rev">
                  <div class="rev__top">
                    <span class="stars" style="--n:{{ r.stars }}" aria-hidden="true"></span>
                    <b>{{ r.autor }}</b>
                    <span class="rev__ok">achiziție confirmată</span>
                    <time>{{ r.data }}</time>
                  </div>
                  <p class="rev__txt">{{ r.text }}</p>
                </li>
              {%- endfor -%}
            </ol>
          </div>
        {%- else -%}
          <p class="acc__empty">Produsul nu are încă recenzii.</p>
        {%- endif -%}
      </section>
    </div>
  </div>

    {%- if pp.related.size > 0 -%}
      <section class="section">
        <h2 class="section__h">Din aceeași categorie</h2>
        <div class="grid-products pdp__rel">
          {%- for product in pp.related limit: 4 -%}
            {%- include "components/product-card.liquid", product: product, density: "standard", eager: false -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Recalculăm prețul aici, cu alte nume. În LiquidJS `{% include %}` vede și
  scrie scope-ul exterior, deci cardurile din „Din aceeași categorie" lăsau în
  urmă propriile `lei_int` și `bani`, iar bara arăta prețul ultimului card.
  În Shopify, `{% render %}` e izolat și problema nu există — dar prototipul
  rulează pe LiquidJS. Vezi docs/ella-mapping.md §3.4b.
{%- endcomment -%}
{%- assign sb_bani_total = p.price | times: 100 | round -%}
{%- assign sb_int = sb_bani_total | divided_by: 100 | floor -%}
{%- assign sb_bani = sb_bani_total | modulo: 100 -%}

{%- comment -%}
  Bara lipită de jos, pe mobil. Înlocuiește bara de navigație — două bare fixe
  ar fi însemnat 112 px de crom pe un ecran de 844.
{%- endcomment -%}
<div class="stickybuy" data-sticky hidden>
  <div class="stickybuy__in">
    <div class="stickybuy__p">
      <span class="price{% if p.compareAt %} price--sale{% endif %}">
        <span aria-hidden="true">{{ sb_int }}<sup>{% if sb_bani < 10 %}0{% endif %}{{ sb_bani }}</sup><span class="price__cur">lei</span></span>
        <span class="visually-hidden">{{ p.price | lei }}</span>
      </span>
      {%- if p.perUnit -%}<span class="stickybuy__u">{{ p.perUnit | lei | remove: " lei" }} lei/buc</span>{%- endif -%}
    </div>
    <button class="btn btn--primary" type="button" data-add="{{ p.handle }}"
            {% unless p.available %}disabled{% endunless %}>
      {%- if p.available -%}Adaugă în coș{%- else -%}Indisponibil{%- endif -%}
    </button>
  </div>
</div>
<script src="{{ '/assets/js/pdp.js' | url }}" defer></script>
