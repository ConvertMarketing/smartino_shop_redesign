---
pagination:
  data: pdp
  size: 1
  alias: pp
permalink: "/products/{{ pp.handle }}/index.html"
layout: layouts/base.liquid
extraCss: /assets/css/pdp.css
hideBottomNav: true
eleventyComputed:
  title: "{{ pp.product.title }}"
  description: "{{ pp.product.title }} — {{ pp.product.vendor }}. Prototip Smartino."
---
{%- assign p = pp.product -%}
{%- assign bani_total = p.price | times: 100 | round -%}
{%- assign lei_int = bani_total | divided_by: 100 | floor -%}
{%- assign bani = bani_total | modulo: 100 -%}

<div class="pdp" data-pdp data-handle="{{ p.handle }}">
<div class="pdp__hero">
  <div class="container">

  <nav class="crumbs" aria-label="Firul de navigare">
    <ol>
      <li><a href="{{ '/' | url }}">Acasă</a></li>
      {%- if pp.crumb -%}
        <li><a href="{{ '/collections/' | append: pp.crumb.handle | append: '/' | url }}">{{ pp.crumb.title }}</a></li>
      {%- endif -%}
      <li><span aria-current="page">{{ p.title | truncate: 48 }}</span></li>
    </ol>
  </nav>

  <div class="pdp__top">

    {%- comment -%}
      Galeria. 913 din 1.203 produse au o singură imagine, deci cazul normal e
      unul singur: bara de miniaturi apare doar când chiar există ce alege.
    {%- endcomment -%}
    <div class="gal{% if p.images.size > 1 %} gal--multi{% endif %}" data-gal>
      <div class="gal__stage">
        {%- for img in p.images limit: 8 -%}
          <figure class="gal__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}">
            <img src="{{ img.src | cdn: 900 }}"
                 srcset="{{ img.src | srcset: 400,600,900,1200 }}"
                 sizes="(min-width: 1000px) 560px, 100vw"
                 alt="{{ img.alt | escape }}"
                 width="900" height="900"
                 {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                 decoding="async">
          </figure>
        {%- endfor -%}
        {%- unless p.available -%}<span class="gal__out">Stoc epuizat</span>{%- endunless -%}
        {%- if p.discountPct -%}<span class="gal__deal">−{{ p.discountPct }}%</span>{%- endif -%}
        {%- if p.images.size > 1 -%}
          <p class="gal__n" data-gal-n><span>1</span> / {{ p.images.size | at_most: 8 }}</p>
        {%- endif -%}
      </div>
      {%- if p.images.size > 1 -%}
        <div class="gal__thumbs" role="tablist" aria-label="Imaginile produsului">
          {%- for img in p.images limit: 8 -%}
            <button class="gal__thumb{% if forloop.first %} is-active{% endif %}" type="button"
                    role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-go="{{ forloop.index0 }}" aria-label="Imaginea {{ forloop.index }}">
              <img src="{{ img.src | cdn: 160 }}" alt="" width="80" height="80" loading="lazy" decoding="async">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Blocul de cumpărare. Ordinea e ordinea deciziei. {%- endcomment -%}
    <div class="buy">
      {%- if p.vendor != blank -%}<p class="buy__brand">{{ p.vendor }}</p>{%- endif -%}
      <h1 class="buy__title">{{ p.title }}</h1>

      {%- if pp.specs.size > 0 -%}
        <ul class="buy__specs">
          {%- for s in pp.specs limit: 3 -%}
            <li><span>{{ s[0] }}</span><b>{{ s[1] }}</b></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <span class="card__rate buy__rate"><span class="card__rate-lbl">rating · Judge.me</span></span>

      <div class="buy__price">
        <span class="price{% if p.compareAt %} price--sale{% endif %}">
          <span aria-hidden="true">{{ lei_int }}<sup>{% if bani < 10 %}0{% endif %}{{ bani }}</sup><span class="price__cur">lei</span></span>
          <span class="visually-hidden">{{ p.price | lei }}</span>
        </span>
        {%- if p.compareAt -%}
          <s class="price__was"><span class="visually-hidden">preț anterior </span>{{ p.compareAt | lei }}</s>
          <span class="buy__save">economisești {{ pp.saves | lei }}</span>
        {%- endif -%}
      </div>

      {%- if p.perUnit -%}
        {%- comment -%}
          Prețul pe bucată nu e o notă sub preț, e al doilea număr al paginii:
          la pachete de 200 și 1.200 de bucăți, e singurul care se compară.
        {%- endcomment -%}
        <div class="unitbox{% if pp.isBest %} unitbox--best{% endif %}">
          <p class="unitbox__n">{{ p.perUnit | lei | remove: " lei" }}<span> lei / bucată</span></p>
          {%- if p.units -%}<p class="unitbox__s">{{ p.units }} bucăți în pachet</p>{%- endif -%}
          {%- if pp.isBest -%}<p class="unitbox__tag">cel mai bun preț pe bucată din familie</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if p.compareAt -%}
        {%- comment -%} Obligatoriu prin OUG 58/2022; istoricul de preț lipsește din date. {%- endcomment -%}
        <p class="buy__omni">Cel mai mic preț din ultimele 30 de zile:
          <span class="card__omni-v">lipsește din date</span></p>
      {%- endif -%}

      {%- comment -%}
        „Alte formate" ține locul selectorului de variante: 1.202 din 1.203
        produse au o singură variantă, dar mărimile și formatele aceleiași linii
        sunt produse separate. Comparate după prețul pe bucată, nu după preț.
      {%- endcomment -%}
      {%- if pp.chart -%}
        {%- comment -%}
          Graficul apare doar când diferența merită arătată — sub 15% ar fi
          patru bare aproape egale. Barele sunt proporționale cu prețul pe
          bucată, nu cu prețul: două pachete de 55 și 156 lei arată aproape la
          fel dacă bara e prețul, și complet diferit dacă e prețul pe bucată.
        {%- endcomment -%}
        <section class="cmp" data-cmp>
          <header class="cmp__head">
            <h2>Cât costă bucata, pe formate</h2>
            <p>Cel mai scump format e cu <b>{{ pp.chart.spread }}×</b> peste cel mai ieftin</p>
          </header>
          <ol class="cmp__list">
            {%- for r in pp.chart.rows -%}
              <li class="cmp__row{% if r.isCurrent %} is-current{% endif %}{% if r.isBest %} is-best{% endif %}">
                {%- if r.isCurrent -%}
                  <span class="cmp__lbl">{{ r.label }}<span class="cmp__you">acesta</span></span>
                {%- else -%}
                  <a class="cmp__lbl" href="{{ '/products/' | append: r.handle | append: '/' | url }}">{{ r.label }}</a>
                {%- endif -%}
                <span class="cmp__bar"><span class="cmp__fill" style="--w:{{ r.pct }}%"></span></span>
                <span class="cmp__u tnum">{{ r.perUnit | lei | remove: " lei" }}</span>
                <span class="cmp__p tnum">{{ r.price | lei }}</span>
              </li>
            {%- endfor -%}
          </ol>
        </section>
      {%- elsif pp.hasChoice -%}
        <section class="fmt">
          <h2 class="fmt__h">Alte formate și mărimi</h2>
          <ul class="fmt__list">
            <li class="fmt__row is-current" aria-current="true">
              <span class="fmt__lbl">{% if p.packDesc %}{{ p.packDesc }}{% elsif p.units %}{{ p.units }} bucăți{% else %}{{ p.title | truncate: 34 }}{% endif %}</span>
              {%- if p.perUnit -%}<span class="fmt__u tnum">{{ p.perUnit | lei | remove: " lei" }} lei/buc</span>{%- endif -%}
              <span class="fmt__p tnum">{{ p.price | lei }}</span>
            </li>
            {%- for s in pp.siblings -%}
              <li class="fmt__row">
                <a href="{{ '/products/' | append: s.handle | append: '/' | url }}">
                  <span class="fmt__lbl">{{ s.label }}</span>
                  {%- if s.perUnit -%}<span class="fmt__u tnum">{{ s.perUnit | lei | remove: " lei" }} lei/buc</span>{%- endif -%}
                  <span class="fmt__p tnum">{{ s.price | lei }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      <p class="buy__stock{% unless p.available %} buy__stock--out{% endunless %}">
        {%- if p.available -%}
          <span class="dot" aria-hidden="true"></span>În stoc — expediere în 24h
        {%- else -%}
          <span class="dot" aria-hidden="true"></span>Stoc epuizat
        {%- endif -%}
      </p>

      <div class="buy__act" data-add-wrap>
        <div class="qty" role="group" aria-label="Cantitate">
          <button type="button" data-q="-1" aria-label="Scade cantitatea">−</button>
          <input type="text" inputmode="numeric" value="1" data-qty aria-label="Cantitate">
          <button type="button" data-q="1" aria-label="Crește cantitatea">+</button>
        </div>
        <button class="btn btn--primary buy__cta" type="button" data-add="{{ p.handle }}"
                {% unless p.available %}disabled{% endunless %}>
          {%- if p.available -%}Adaugă în coș{%- else -%}Indisponibil{%- endif -%}
        </button>
      </div>

      <ul class="buy__ship">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
          <span>{% if p.price >= shop.freeShipping %}<b>Livrare gratuită</b> la această comandă{% else %}Livrare <b>{{ shop.shippingFee | lei }}</b> · gratuită peste {{ shop.freeShipping }} lei{% endif %}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>Comandat azi, livrat în <b>1–3 zile</b> lucrătoare</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
          <span>Retur în <b>{{ shop.returnDays }} zile</b>, conform OUG 34/2014</span>
        </li>
      </ul>
    </div>
  </div>

  </div>
</div>

<div class="container pdp__rest">
    {%- if pp.body != blank -%}
      <details class="acc" open>
        <summary class="acc__sum"><h2>Descriere</h2>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="acc__body rte">{{ pp.body }}</div>
      </details>
    {%- endif -%}

    {%- if pp.specs.size > 0 -%}
      <details class="acc" open>
        <summary class="acc__sum"><h2>Specificații</h2>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="acc__body">
          <dl class="spectable">
            {%- for s in pp.specs -%}<div><dt>{{ s[0] }}</dt><dd>{{ s[1] }}</dd></div>{%- endfor -%}
          </dl>
          <p class="spectable__note">Valorile sunt extrase din titlul produsului.
          La implementare devin metacâmpuri — vezi docs/ella-mapping.md §3.4.</p>
        </div>
      </details>
    {%- endif -%}

    <details class="acc">
      <summary class="acc__sum"><h2>Recenzii</h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="acc__body">
        <p class="acc__empty">Recenziile vin din Judge.me, care nu e în exportul curent.
        Spațiul e rezervat aici și pe card, ca apariția lor să nu mute pagina.</p>
      </div>
    </details>

    {%- if pp.related.size > 0 -%}
      <section class="section">
        <h2 class="section__h">Din aceeași categorie</h2>
        <div class="grid-products pdp__rel">
          {%- for product in pp.related limit: 4 -%}
            {%- include "components/product-card.liquid", product: product, density: "standard", eager: false -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Recalculăm prețul aici, cu alte nume. În LiquidJS `{% include %}` vede și
  scrie scope-ul exterior, deci cardurile din „Din aceeași categorie" lăsau în
  urmă propriile `lei_int` și `bani`, iar bara arăta prețul ultimului card.
  În Shopify, `{% render %}` e izolat și problema nu există — dar prototipul
  rulează pe LiquidJS. Vezi docs/ella-mapping.md §3.4b.
{%- endcomment -%}
{%- assign sb_bani_total = p.price | times: 100 | round -%}
{%- assign sb_int = sb_bani_total | divided_by: 100 | floor -%}
{%- assign sb_bani = sb_bani_total | modulo: 100 -%}

{%- comment -%}
  Bara lipită de jos, pe mobil. Înlocuiește bara de navigație — două bare fixe
  ar fi însemnat 112 px de crom pe un ecran de 844.
{%- endcomment -%}
<div class="stickybuy" data-sticky hidden>
  <div class="stickybuy__in">
    <div class="stickybuy__p">
      <span class="price{% if p.compareAt %} price--sale{% endif %}">
        <span aria-hidden="true">{{ sb_int }}<sup>{% if sb_bani < 10 %}0{% endif %}{{ sb_bani }}</sup><span class="price__cur">lei</span></span>
        <span class="visually-hidden">{{ p.price | lei }}</span>
      </span>
      {%- if p.perUnit -%}<span class="stickybuy__u">{{ p.perUnit | lei | remove: " lei" }} lei/buc</span>{%- endif -%}
    </div>
    <button class="btn btn--primary" type="button" data-add="{{ p.handle }}"
            {% unless p.available %}disabled{% endunless %}>
      {%- if p.available -%}Adaugă în coș{%- else -%}Indisponibil{%- endif -%}
    </button>
  </div>
</div>
<script src="{{ '/assets/js/pdp.js' | url }}" defer></script>
